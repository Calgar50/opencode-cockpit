      "*.tfvars": "deny",
      "*.TFVARS": "deny",
      "*.env.example": "allow"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pfx": "deny",
      "*.PFX": "deny",
      "*.p12": "deny",
      "*.P12": "deny",
      "*.key": "deny",
      "*.KEY": "deny",
      "*.jks": "deny",
      "*.JKS": "deny",
      "*.keystore": "deny",
      "*.KEYSTORE": "deny",
      "*.kdbx": "deny",
      "*.KDBX": "deny",
      "*privkey*": "deny",
      "*-key.pem": "deny",
      "*_key.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "*kubeconfig*": "deny",
      "*.kube/config": "deny",
      "*.asc": "deny",
      "*.ASC": "deny",
      "*.cer": "deny",
      "*.CER": "deny",
      "*.crt": "deny",
      "*.CRT": "deny",
      "*.der": "deny",
      "*.DER": "deny",
      "*.gpg": "deny",
