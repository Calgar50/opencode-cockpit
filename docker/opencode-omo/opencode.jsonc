      "*.pem": "deny",
      "*.PEM": "deny",
      "*.tfstate": "deny",
      "*.TFSTATE": "deny",
      "*.tfvars": "deny",
      "*.TFVARS": "deny",
      "*.env.example": "allow"
    },
    "bash": "ask",
    "task": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
