      "*.kdbx": "deny",
      "*.KDBX": "deny",
      "*privkey*": "deny",
      "*-key.pem": "deny",
      "*_key.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
