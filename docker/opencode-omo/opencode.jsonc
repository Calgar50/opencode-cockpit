      "*.tfstate": "deny",
      "*.TFSTATE": "deny",
      "*.tfvars": "deny",
      "*.TFVARS": "deny",
      "*.env.example": "ask"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env*": "deny",
      "*/.env*": "deny",
      "*.pfx": "deny",
