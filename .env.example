# Modèle de configuration. install.ps1 génère le vrai `.env` (jamais versionné).

# Dossier de vos projets, monté dans les conteneurs sous /workspace (barres obliques).
WORKSPACE_DIR=C:/dev
# Export Markdown des conversations classées (dossier visible dans l'explorateur Windows).
ARCHIVE_DIR=./archives
# Port local de l'interface : http://127.0.0.1:7777
COCKPIT_PORT=7777

# Secrets générés aléatoirement par install.ps1 (ne pas partager).
COCKPIT_TOKEN=
OPENCODE_SERVER_PASSWORD=

# Proxy d'entreprise (laisser vide si aucun). Exemple : http://proxy.entreprise.lan:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 0 = TLS vérifié avec les certificats de certs/ (recommandé). 1 = secours sans vérification.
COCKPIT_TLS_INSECURE=0

# 0 = ignore le dossier .opencode/ des dépôts (recommandé : un dépôt pourrait y exécuter du code).
# 1 = autorise agents, commandes, skills et plugins par projet (dépôts de confiance uniquement).
COCKPIT_PROJECT_CONFIG=0

# GitHub Enterprise avec résidence des données uniquement (ex. entreprise.ghe.com) : seul domaine
# vers lequel la synchronisation facultative du solde peut envoyer le jeton Copilot.
COCKPIT_GITHUB_ENTERPRISE_DOMAIN=

# Images : construites localement par défaut, ou téléchargées depuis GHCR (voir README).
COCKPIT_OPENCODE_IMAGE=opencode-cockpit/opencode:local
COCKPIT_APP_IMAGE=opencode-cockpit/app:local

TZ=Europe/Paris
