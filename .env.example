# Modèle de configuration. install.ps1 génère le vrai `.env` (jamais versionné).

# Dossier de vos projets, monté dans les conteneurs sous /workspace (barres obliques).
WORKSPACE_DIR=C:/dev
# Export Markdown des conversations classées (dossier visible dans l'explorateur Windows).
ARCHIVE_DIR=./archives
# Port local de l'interface : https://127.0.0.1:7777 (certificat local, avertissement du navigateur au premier accès)
COCKPIT_PORT=7777
# Mode d'accès local : https (défaut) ou http (choisi avec install.ps1 -Http et confirmé ;
# trafic non chiffré sur la boucle locale). Toute autre valeur empêche le démarrage.
COCKPIT_LOCAL_SCHEME=https
# Date UTC de confirmation du mode http, écrite par install.ps1 (ne pas modifier).
COCKPIT_LOCAL_HTTP_CONFIRMED=

# Secrets générés aléatoirement par install.ps1 (ne pas partager).
COCKPIT_TOKEN=
OPENCODE_SERVER_PASSWORD=

# Proxy d'entreprise (laisser vide si aucun). Exemple : http://proxy.entreprise.lan:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 0 = TLS vérifié avec les certificats de certs/ (recommandé). 1 = secours sans vérification.
COCKPIT_TLS_INSECURE=0

# 0 = ignore le dossier .opencode/ des dépôts (recommandé : un dépôt pourrait y exécuter du code).
# 1 = autorise agents, commandes, skills et plugins par projet (dépôts de confiance uniquement).
COCKPIT_PROJECT_CONFIG=0

# GitHub Enterprise avec résidence des données uniquement (ex. entreprise.ghe.com) : seul domaine
# accepté pour la connexion Copilot Enterprise, et vers lequel la synchronisation facultative du solde
# peut envoyer le jeton Copilot.
COCKPIT_GITHUB_ENTERPRISE_DOMAIN=

# Images : construites localement par défaut, ou téléchargées depuis GHCR (voir README).
COCKPIT_OPENCODE_IMAGE=opencode-cockpit/opencode:local
COCKPIT_APP_IMAGE=opencode-cockpit/app:local
# Mode d'installation mémorisé par install.ps1 (Build, Pull ou Load) : une relance sans -Mode,
# ou cockpit.ps1 update, le reprend. Registre du mode Pull : vide = défaut de la version installée.
COCKPIT_INSTALL_MODE=Build
# Version affichée dans l'interface, recopiée du fichier VERSION par install.ps1 (mode Build).
COCKPIT_VERSION=
COCKPIT_IMAGE_REGISTRY=
# direct = connexion sans proxy choisie avec « install.ps1 -Proxy '' » (plus de détection automatique) ;
# manual = proxy passé avec -Proxy ou saisi dans HTTPS_PROXY (information seulement, non relue).
COCKPIT_PROXY_MODE=

# Facultatif : noms d'hôte acceptés dans l'en-tête Host (défaut localhost,127.0.0.1,[::1]).
# Seuls des noms en .localhost fonctionnent en plus (le navigateur refuse ailleurs le cookie de connexion).
# En HTTPS, chaque nom ajouté entre dans le certificat local : nouvelle empreinte, nouvel avertissement.
# COCKPIT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],cockpit.localhost

TZ=Europe/Paris

# --- Salle Oh My OpenAgent (facultative, mode Avancé) ------------------------------------------------
# Interrupteur de la salle : off (défaut) ou on. install.ps1 ne le met JAMAIS à on tout seul ; l'activation
# se fait depuis l'interface. À off, le service de la salle n'est même pas créé (profil compose « omo »).
COCKPIT_OMO=off
# Étiquette de l'image de la salle, écrite par « install.ps1 -OmoArchive <archive> » après vérification de
# l'empreinte de l'archive et de l'identifiant d'image. Cette image n'est jamais publiée ni téléchargée.
COCKPIT_OMO_IMAGE=
# Mot de passe du serveur opencode de la salle, tiré au hasard par install.ps1 et jamais affiché.
# OPENCODE_OMO_PASSWORD=
# Adresse du serveur de la salle, vue depuis le cockpit (défaut : le service de la salle sur le réseau interne).
# OPENCODE_OMO_URL=
# Emplacements, dans le conteneur du cockpit, des fichiers de contrôle de la salle (défauts de l'image).
# COCKPIT_OMO_CONTROL_DIR=
# COCKPIT_OMO_STATE_DIR=
# COCKPIT_OMO_AUTH_DIR=
# COCKPIT_OMO_PROJECTS_FILE=
# Journal des sorties réseau refusées, lu par le Diagnostic.
# COCKPIT_EGRESS_JOURNAL=
# Les projets préparés et les montages .git en lecture seule sont écrits par install.ps1 dans
# omo-projets.json et docker-compose.omo-projets.yml : ne les modifiez pas à la main, relancez install.ps1.

# Écrites par install.ps1 lors du passage à la 1.0.5, utilisées par « cockpit.ps1 rollback » : ne pas modifier.
# COCKPIT_PREVIOUS_VERSION=
# COCKPIT_PREVIOUS_APP_IMAGE=
# COCKPIT_PREVIOUS_OPENCODE_IMAGE=
# COCKPIT_PREVIOUS_INSTALL_MODE=
