{
  "name": "opencode-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Poste de pilotage web pour opencode : chat, agents, skills, archives classées et suivi des coûts GitHub Copilot.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env.dev server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.11",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "marked": "18.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
