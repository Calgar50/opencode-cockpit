# --- Secrets (jamais dans git) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
id_*
secrets/
certs/*
!certs/README.md
auth.json
credentials*.json
# Certificat du HTTPS local en développement (npm run dev:server) : clé privée, jamais versionnée.
app/.tls-dev/

# --- Données locales de l'outil ---
data/
# Projets préparés et surcharge compose de la salle, générés par install.ps1 sur le poste (jamais versionnés).
/omo-projets.json
/docker-compose.omo-projets.yml
workspace/
# Installations d'essai créées à la racine du dépôt (bancs, répétition générale).
testinstall/

# --- Build / dépendances ---
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# --- Divers ---
__pycache__/
*.log
.DS_Store
Thumbs.db
.idea/

# Sauvegardes locales
backups/

# Exports Markdown des conversations (peuvent contenir du code ou des secrets)
/archives/
